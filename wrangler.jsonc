{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frostnav-wiki",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Yalnızca /oauth/* Worker koduna gider (Decap CMS girişi); geri kalan her şey statik dosyadır.
    "run_worker_first": ["/oauth/*"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [{"pattern": "wiki.frostnav.com", "custom_domain": true}]
  // Gizli değerler: npx wrangler secret put GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
}
